config USER_HELP
	bool "VibeOS help command"
	default y

config USER_COREUTILS
	bool "GNU coreutils"
	default y

config USER_BASH
	bool "Bash shell"
	default y

config USER_FILE
	bool "file(1)"
	default y

config USER_NANO
	bool "nano editor"
	default y

config USER_LESS
	bool "less pager"
	default y

config USER_VIM
	bool "Vim editor"
	default y

config USER_SL
	bool "sl demo program"
	default y

config USER_MAN_PAGES
	bool "VibeOS man-pages (adapted from Linux)"
	default y

config USER_MAN_DB
	bool "man-db reader"
	default y

config USER_WGET
	bool "wget with TLS support"
	default y

config USER_KERNEL_TESTS
	bool "Kernel test suite in /usr"
	default y

config USER_GLIBC_DYNAMIC
	bool "glibc dynamic runtime and integration test"
	default y

config USER_X11
	bool "XLibre framebuffer X11 server and client runtime"
	default y

